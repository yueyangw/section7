---
interface Props {
  src?: string;
  bilibili?: string;
  title?: string;
}
const { src, bilibili, title = '视频' } = Astro.props;
---

<figure class="figure">
  {
    bilibili ? (
      <div style="position:relative;aspect-ratio:16/9">
        <iframe
          src={`https://player.bilibili.com/player.html?bvid=${bilibili}&autoplay=0`}
          title={title}
          loading="lazy"
          allowfullscreen
          style="position:absolute;inset:0;width:100%;height:100%;border:1px solid var(--ink)"
        />
      </div>
    ) : (
      <video src={src} controls preload="metadata" style="width:100%" />
    )
  }
  <figcaption>{title}</figcaption>
</figure>
