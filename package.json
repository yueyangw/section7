{
  "name": "section7-theme",
  "version": "0.1.0",
  "description": "section7：man page 风格的 Astro 博客主题",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./src/node/index.d.ts",
      "default": "./src/node/index.js"
    },
    "./content": "./content.ts",
    "./types": "./src/config/types.ts"
  },
  "files": [
    "src",
    "content.ts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "pnpm --filter demo dev",
    "build": "pnpm --filter demo build",
    "preview": "pnpm --filter demo preview",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "pnpm --filter demo check"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "@astrojs/react": "^7.0.0",
    "@astrojs/mdx": "^8.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@fontsource/noto-serif-sc": "^5.3.1",
    "@shikijs/rehype": "^4.5.0",
    "@shikijs/transformers": "^4.5.0",
    "artalk": "^2.10.1",
    "hast-util-from-html": "^2.0.3",
    "hast-util-to-string": "^3.0.1",
    "mathjax-full": "^3.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vfile": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
